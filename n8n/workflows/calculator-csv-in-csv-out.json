{
  "name": "Calculator: CSV in → CSV out",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "csv",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "3f0c6a1e-5b7d-4c2a-9e8f-1a2b3c4d5e02"
    },
    {
      "id": "hasfile",
      "name": "Has file?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "hasfile-cond",
              "leftValue": "={{ $binary.file !== undefined }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "extract",
      "name": "Extract CSV",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        440,
        -100
      ],
      "parameters": {
        "operation": "csv",
        "binaryPropertyName": "file",
        "options": {}
      },
      "onError": "continueErrorOutput",
      "alwaysOutputData": true
    },
    {
      "id": "hasrows",
      "name": "Has rows?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        660,
        -200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "hasrows-cond",
              "leftValue": "={{ Object.keys($json).length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "calc",
      "name": "Calculate each row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        880,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/calculate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ expression: String($json.expression ?? Object.values($json)[0] ?? ''), client_id: $('Webhook').first().json.query.client_id || 'n8n-csv' }) }}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "shape",
      "name": "Shape row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// One API response -> one result row. Extract CSV holds the original expression.\nconst expression = String($('Extract CSV').item.json.expression ?? Object.values($('Extract CSV').item.json)[0] ?? '');\nconst { statusCode, body } = $json;\nif (statusCode === 200) {\n  return { json: { expression, result: body.result, error: null } };\n}\nconst error = body?.error ?? `calculator unavailable (${statusCode ?? 'no response'})`;\nreturn { json: { expression, result: null, error } };\n"
      }
    },
    {
      "id": "tocsv",
      "name": "Convert to CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        1320,
        -200
      ],
      "parameters": {
        "operation": "csv",
        "binaryPropertyName": "data",
        "options": {
          "fileName": "results.csv"
        }
      }
    },
    {
      "id": "send",
      "name": "Respond with file",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1540,
        -200
      ],
      "parameters": {
        "respondWith": "binary",
        "responseDataSource": "automatically",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Disposition",
                "value": "attachment; filename=\"results.csv\""
              }
            ]
          }
        }
      }
    },
    {
      "id": "bad",
      "name": "Respond bad request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        880,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\": \"upload a non-empty CSV file in form field \\\"file\\\" with an \\\"expression\\\" header\"}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Has file?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has file?": {
      "main": [
        [
          {
            "node": "Extract CSV",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond bad request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract CSV": {
      "main": [
        [
          {
            "node": "Has rows?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond bad request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has rows?": {
      "main": [
        [
          {
            "node": "Calculate each row",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond bad request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate each row": {
      "main": [
        [
          {
            "node": "Shape row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape row": {
      "main": [
        [
          {
            "node": "Convert to CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert to CSV": {
      "main": [
        [
          {
            "node": "Respond with file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
