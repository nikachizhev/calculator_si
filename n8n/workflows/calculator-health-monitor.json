{
  "name": "Calculator: health monitor",
  "nodes": [
    {
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "health",
      "name": "Check health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8000/api/health",
        "options": {
          "timeout": 3000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "healthy",
      "name": "Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        440,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "healthy-cond",
              "leftValue": "={{ $json.statusCode === 200 && $json.body?.status === 'ok' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ok",
      "name": "Healthy",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        -200
      ],
      "parameters": {}
    },
    {
      "id": "down",
      "name": "Report outage",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        660,
        60
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ $json.statusCode ? 'Calculator unhealthy: HTTP ' + $json.statusCode : 'Calculator unreachable: ' + ($json.error?.message ?? $json.error ?? 'no response') }}"
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Check health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check health": {
      "main": [
        [
          {
            "node": "Healthy?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report outage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Healthy?": {
      "main": [
        [
          {
            "node": "Healthy",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report outage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Moscow",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  }
}
