{
  "name": "Calculator: webhook → API → respond",
  "nodes": [
    {
      "id": "wh",
      "name": "Webhook",
      "webhookId": "7c1f3a52-9d4e-4b8a-a6f1-2e5d0c9b8a31",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        20
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "calculate",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "http",
      "name": "Call Calculator API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/calculate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ expression: $json.body.expression, client_id: $json.body.client_id || 'n8n' }) }}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "if",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ok",
      "name": "Respond Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { expression: $('Webhook').item.json.body.expression, result: $json.body?.result, id: $json.body?.id } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "err",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { expression: $('Webhook').item.json.body.expression, error: $json.body?.error ?? ('calculator unavailable (HTTP ' + $json.statusCode + ')') } }}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Call Calculator API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Calculator API": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success?": {
      "main": [
        [
          {
            "node": "Respond Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
