# Copy to .env and fill in. .env is git-ignored.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# host.docker.internal lets n8n (in Docker) reach Django
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
# CALCULATOR_DATABASE=/absolute/path/to/calculator.db

# n8n (used by n8n/deploy.sh)
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
